<Window x:Class="LabAnalyzerSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Analyzer Simulator"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Text="Laboratory Analyzer Simulator"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,10"/>

        <!-- Connection -->
        <GroupBox Header="Connection"
                  Grid.Row="1"
                  Margin="0,5">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Port -->

                <TextBlock
        Text="Port:"
        VerticalAlignment="Center"/>

                <TextBox
        x:Name="PortTextBox"
        Grid.Column="1"
        Margin="5"
        Text="5000"/>

                <!-- Start -->

                <Button
        x:Name="StartButton"
        Grid.Column="2"
        Margin="5"
        Width="100"
        Height="30"
        Content="Start Server"
        Click="StartButton_Click"/>

                <!-- Stop -->

                <Button
        x:Name="StopButton"
        Grid.Column="3"
        Margin="5"
        Width="100"
        Height="30"
        Content="Stop Server"
        Click="StopButton_Click"/>

                <!-- Status -->

                <TextBlock
        Grid.Row="1"
        Grid.ColumnSpan="4"
        Margin="5"
        FontWeight="Bold"
        x:Name="StatusTextBlock"
        Text="Stopped"/>

                <!-- Log -->

                <TextBox
        x:Name="LogTextBox"
        Grid.Row="2"
        Grid.ColumnSpan="4"
        Margin="5"
        AcceptsReturn="True"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto"
        IsReadOnly="True"
        TextWrapping="Wrap"/>

            </Grid>

        </GroupBox>

        <!-- Orders -->
        <GroupBox Header="Orders"
                  Grid.Row="2"
                  Margin="0,5">

            <DataGrid Name="OrdersGrid"/>

        </GroupBox>

        <!-- Log -->
        <GroupBox Header="Communication Log"
          Grid.Row="3"
          Margin="0,5">

            <TextBox
        x:Name="CommunicationLogTextBox"
        AcceptsReturn="True"
        IsReadOnly="True"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Auto"
        TextWrapping="Wrap"/>

        </GroupBox>

    </Grid>

</Window>
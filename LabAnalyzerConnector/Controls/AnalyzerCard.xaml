<UserControl x:Class="LabAnalyzerConnector.Controls.AnalyzerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="White"
        BorderBrush="#E2E8F0"
        BorderThickness="1"
        CornerRadius="14"
        Margin="0,0,4,12"
        Padding="20">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ANALYZER NAME -->

                <StackPanel>

                    <StackPanel Orientation="Horizontal">

                        <Border
                            Width="34"
                            Height="34"
                            CornerRadius="17"
                            Background="#EFF6FF"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="⚗"
                                FontSize="19"
                                Foreground="#2563EB"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Margin="10,0,0,0">

                            <TextBlock
                                FontSize="17"
                                FontWeight="Bold"
                                Foreground="#111827"
                                Text="{Binding Analyzer.Name,
                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                    Mode=OneWay}"/>

                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="#64748B">

                                <Run
                                    Text="{Binding Analyzer.Manufacturer,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        Mode=OneWay}"/>

                                <Run Text="  •  "/>

                                <Run
                                    Text="{Binding Analyzer.Model,
                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                        Mode=OneWay}"/>

                            </TextBlock>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- STATUS -->

                <Border
                    Grid.Column="1"
                    Padding="12,6"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    CornerRadius="18"
                    VerticalAlignment="Top">

                    <StackPanel
                        Orientation="Horizontal">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#EF4444"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#DC2626"
                            Text="{Binding Analyzer.StatusText,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Mode=OneWay}"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- INFORMATION -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="1"
                Margin="0,18,0,18">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- LAST COMMUNICATION -->

                <Border
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    Padding="12"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="9">

                    <StackPanel>

                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            Text="LAST COMMUNICATION"/>

                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="12"
                            Foreground="#172033"
                            Text="{Binding Analyzer.LastReceivedText,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Mode=OneWay}"/>

                    </StackPanel>

                </Border>


                <!-- MESSAGES -->

                <Border
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Padding="12"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="9">

                    <StackPanel>

                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            Text="MESSAGES"/>

                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#2563EB"
                            Text="{Binding Analyzer.ReceivedMessages.Count,
                                RelativeSource={RelativeSource AncestorType=UserControl},
                                Mode=OneWay}"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- ACTION BUTTONS -->
            <!-- ================================================= -->

            <WrapPanel
                Grid.Row="2"
                HorizontalAlignment="Right">


                <!-- CONNECT -->

                <Button
                    Content="▷  Connect"
                    Width="95"
                    Height="34"
                    Margin="3"
                    Background="#EFF6FF"
                    Foreground="#1D4ED8"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ConnectButton_Click"/>


                <!-- DISCONNECT -->

                <Button
                    Content="□  Disconnect"
                    Width="105"
                    Height="34"
                    Margin="3"
                    Background="#FEF2F2"
                    Foreground="#DC2626"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="DisconnectButton_Click"/>


                <!-- RECONNECT -->

                <Button
                    Content="↻  Reconnect"
                    Width="100"
                    Height="34"
                    Margin="3"
                    Background="#FFF7ED"
                    Foreground="#C2410C"
                    BorderBrush="#FED7AA"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ReconnectButton_Click"/>


                <!-- MANAGE -->

                <Button
                    Content="⚙  Manage"
                    Width="95"
                    Height="34"
                    Margin="3"
                    Background="#F8FAFC"
                    Foreground="#334155"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ManageButton_Click"/>


                <!-- MESSAGES -->

                <Button
                    Content="▱  Messages"
                    Width="105"
                    Height="34"
                    Margin="3"
                    Background="#EFF6FF"
                    Foreground="#1D4ED8"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="MessagesButton_Click"/>


                <!-- RESULTS -->

                <Button
                    Content="▥  Results"
                    Width="95"
                    Height="34"
                    Margin="3"
                    Background="#ECFDF5"
                    Foreground="#15803D"
                    BorderBrush="#BBF7D0"
                    BorderThickness="1"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ResultsButton_Click"/>

            </WrapPanel>

        </Grid>

    </Border>

</UserControl>
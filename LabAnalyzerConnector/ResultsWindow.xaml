<Window x:Class="LabAnalyzerConnector.ResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laboratory Results"
        Width="1250"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="Laboratory Results"
                    FontSize="28"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Results received from connected laboratory analyzers"
                    Margin="0,5,0,0"
                    Foreground="#6B7280"/>

            </StackPanel>

            <Button
                Grid.Column="1"
                Content="Refresh"
                Width="100"
                Height="35"
                Click="RefreshButton_Click"/>

        </Grid>


        <!-- ================================================= -->
        <!-- SUMMARY -->
        <!-- ================================================= -->

        <Border
            Grid.Row="1"
            Margin="0,20,0,15"
            Padding="15"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">

            <StackPanel
                Orientation="Horizontal">

                <TextBlock
                    Text="Results:"
                    FontWeight="SemiBold"/>

                <TextBlock
                    Margin="8,0,0,0"
                    Text="{Binding Results.Count}"/>

                <TextBlock
                    Margin="30,0,0,0"
                    Text="{Binding StatusMessage}"
                    Foreground="#6B7280"/>

            </StackPanel>

        </Border>


        <!-- ================================================= -->
        <!-- RESULTS GRID -->
        <!-- ================================================= -->

        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="8">

            <DataGrid
                ItemsSource="{Binding Results}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                SelectionMode="Single">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Received"
                        Binding="{Binding ReceivedAtText}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Analyzer"
                        Binding="{Binding AnalyzerName}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Patient ID"
                        Binding="{Binding PatientId}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Sample ID"
                        Binding="{Binding SampleId}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Test Code"
                        Binding="{Binding TestCode}"
                        Width="110"/>

                    <DataGridTextColumn
                        Header="Standard Code"
                        Binding="{Binding StandardTestCode}"
                        Width="120"/>

                    <DataGridTextColumn
                        Header="Test"
                        Binding="{Binding TestName}"
                        Width="180"/>

                    <DataGridTextColumn
                        Header="Result"
                        Binding="{Binding ResultValue}"
                        Width="100"/>

                    <DataGridTextColumn
                        Header="Units"
                        Binding="{Binding Units}"
                        Width="90"/>

                    <DataGridTextColumn
                        Header="Reference Range"
                        Binding="{Binding ReferenceRange}"
                        Width="150"/>

                    <DataGridTextColumn
                        Header="Flag"
                        Binding="{Binding AbnormalFlag}"
                        Width="80"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">

            <Button
                Content="Close"
                Width="100"
                Height="35"
                Click="CloseButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
<Window x:Class="LabAnalyzerConnector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab Analyzer Connector"
        Width="1250"
        Height="800"
        MinWidth="1050"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- PRIMARY BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Margin"
                    Value="4,0"/>

            <Setter Property="Background"
                    Value="#2563EB"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ===================================================== -->
        <!-- SECONDARY BUTTON -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Margin"
                    Value="4,0"/>

            <Setter Property="Background"
                    Value="#FFFFFF"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>


        <!-- ===================================================== -->
        <!-- SUMMARY CARD -->
        <!-- ===================================================== -->

        <Style x:Key="SummaryCard"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="20"/>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN WINDOW -->
    <!-- ========================================================= -->

    <Grid Background="#F3F4F6">


        <!-- ===================================================== -->
        <!-- MAIN ROWS -->
        <!-- ===================================================== -->

        <Grid.RowDefinitions>

            <RowDefinition Height="76"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="28,0">

                <Grid.ColumnDefinitions>

                    <!-- TITLE -->
                    <ColumnDefinition Width="*"/>

                    <!-- SYSTEM STATUS -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- ACTION BUTTONS -->
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="0"
                VerticalAlignment="Center">

                    <TextBlock Text="Lab Analyzer Connector"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="#111827"/>

                    <TextBlock Text="Analyzer Management Dashboard"
                   FontSize="12"
                   Foreground="#6B7280"
                   Margin="0,3,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SYSTEM STATUS -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="0,0,20,0">

                    <Ellipse Width="10"
                 Height="10"
                 Fill="#16A34A"
                 Margin="0,0,8,0"/>

                    <TextBlock Text="System Running"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#374151"
                   VerticalAlignment="Center"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- ACTION BUTTONS -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                    <!-- CREATE ORDER -->

                   


                    <!-- ORDERS -->

                    <Button Content="Orders"
                Width="100"
                Height="35"
                Margin="0,0,8,0"
                Style="{StaticResource SecondaryButton}"
                Click="OrdersButton_Click"/>


                    <!-- ADD ANALYZER -->

                    <Button Content="+  Add Analyzer"
                Width="145"
                Style="{StaticResource PrimaryButton}"
                Click="AddAnalyzerButton_Click"/>

                    <Button Grid.Column="2"
        Content="Create Order"
        Width="130"
        Height="34"
        Margin="4,0"
        Click="CreateOrderButton_Click"/>


                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1"
              Margin="28">


            <Grid.RowDefinitions>

                <!-- Summary -->
                <RowDefinition Height="Auto"/>

                <!-- Analyzer Section -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- SUMMARY CARDS -->
            <!-- ================================================= -->

            <Grid Grid.Row="0"
                  Margin="0,0,0,22">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- TOTAL ANALYZERS -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Style="{StaticResource SummaryCard}"
                        Margin="0,0,8,0">

                    <StackPanel>

                        <TextBlock Text="TOTAL ANALYZERS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"/>

                        <TextBlock Text="{Binding Analyzers.Count, Mode=OneWay}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Configured analyzers"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- CONNECTED -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Style="{StaticResource SummaryCard}"
                        Margin="8,0">

                    <StackPanel>

                        <TextBlock Text="CONNECTED"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"/>

                        <TextBlock Text="{Binding ConnectedAnalyzerCount, Mode=OneWay}"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,6,0,0"/>

                        <TextBlock Text="Active analyzer connections"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- SYSTEM STATUS -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Style="{StaticResource SummaryCard}"
                        Margin="8,0,0,0">

                    <StackPanel>

                        <TextBlock Text="SYSTEM STATUS"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#6B7280"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,6,0,0">

                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="#16A34A"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>

                            <TextBlock Text="Running"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"/>

                        </StackPanel>

                        <TextBlock Text="Interface engine is active"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   Margin="0,2,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- ANALYZER SECTION -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="22">

                <Grid>

                    <Grid.RowDefinitions>

                        <!-- Section Header -->
                        <RowDefinition Height="Auto"/>

                        <!-- Analyzer List -->
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>


                    <!-- ================================================= -->
                    <!-- SECTION HEADER -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="0"
                          Margin="0,0,0,18">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="Configured Analyzers"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#111827"/>

                            <TextBlock Text="Monitor connections and incoming laboratory messages"
                                       FontSize="12"
                                       Foreground="#6B7280"
                                       Margin="0,4,0,0"/>

                        </StackPanel>


                        <!-- ANALYZER COUNT -->

                        <Border Grid.Column="1"
                                Background="#EFF6FF"
                                CornerRadius="15"
                                Padding="12,6"
                                VerticalAlignment="Center">

                            <TextBlock FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#2563EB">

                                <Run Text="Analyzers: "/>

                                <Run Text="{Binding Analyzers.Count, Mode=OneWay}"/>

                            </TextBlock>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- ANALYZER LIST -->
                    <!-- ================================================= -->

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Analyzers, Mode=OneWay}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <!-- ANALYZER CARD -->

                                    <Border Background="#FAFAFA"
                                            BorderBrush="#E5E7EB"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="20"
                                            Margin="0,0,0,16">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <!-- Header -->
                                                <RowDefinition Height="Auto"/>

                                                <!-- Divider -->
                                                <RowDefinition Height="Auto"/>

                                                <!-- Data Header -->
                                                <RowDefinition Height="Auto"/>

                                                <!-- Data -->
                                                <RowDefinition Height="250"/>

                                                <!-- Buttons -->
                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>


                                            <!-- ================================================= -->
                                            <!-- ANALYZER HEADER -->
                                            <!-- ================================================= -->

                                            <Grid Grid.Row="0"
                                                  Margin="0,0,0,15">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>


                                                <!-- ANALYZER INFO -->

                                                <StackPanel>

                                                    <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                               FontSize="17"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827"/>

                                                    <TextBlock FontSize="12"
                                                               Foreground="#6B7280"
                                                               Margin="0,5,0,0">

                                                        <Run Text="{Binding Manufacturer, Mode=OneWay}"/>

                                                        <Run Text="  •  "/>

                                                        <Run Text="{Binding Model, Mode=OneWay}"/>

                                                    </TextBlock>

                                                </StackPanel>


                                                <!-- STATUS -->

                                                <Border Grid.Column="1"
                                                        Background="#ECFDF5"
                                                        CornerRadius="15"
                                                        Padding="12,6">

                                                    <StackPanel Orientation="Horizontal">

                                                        <Ellipse Width="9"
                                                                 Height="9"
                                                                 Fill="{Binding StatusColor}"
                                                                 Margin="0,0,7,0"
                                                                 VerticalAlignment="Center"/>

                                                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#166534"/>

                                                    </StackPanel>

                                                </Border>

                                            </Grid>


                                            <!-- ================================================= -->
                                            <!-- DIVIDER -->
                                            <!-- ================================================= -->

                                            <Border Grid.Row="1"
                                                    Height="1"
                                                    Background="#E5E7EB"
                                                    Margin="0,0,0,15"/>


                                            <!-- ================================================= -->
                                            <!-- RECEIVED DATA HEADER -->
                                            <!-- ================================================= -->

                                            <Grid Grid.Row="2"
                                                  Margin="0,0,0,8">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>


                                                <StackPanel>

                                                    <TextBlock Text="Received Data"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#111827"/>

                                                    <TextBlock Text="{Binding LastReceivedText, Mode=OneWay}"
                                                               FontSize="11"
                                                               Foreground="#6B7280"
                                                               Margin="0,3,0,0"/>

                                                </StackPanel>


                                                <!-- MESSAGE COUNT -->

                                                <Border Grid.Column="1"
                                                        Background="#F3F4F6"
                                                        CornerRadius="15"
                                                        Padding="12,6"
                                                        VerticalAlignment="Center">

                                                    <TextBlock FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#374151">

                                                        <Run Text="Messages: "/>

                                                        <Run Text="{Binding ReceivedMessages.Count, Mode=OneWay}"/>

                                                    </TextBlock>

                                                </Border>

                                            </Grid>


                                            <!-- ================================================= -->
                                            <!-- DATA LOG -->
                                            <!-- ================================================= -->

                                            <Border Grid.Row="3"
                                                    Background="#111827"
                                                    BorderBrush="#374151"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="12"
                                                    Margin="0,0,0,15">

                                                <ListBox ItemsSource="{Binding ReceivedMessages, Mode=OneWay}"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="#F9FAFB"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                                    <ListBox.ItemContainerStyle>

                                                        <Style TargetType="ListBoxItem">

                                                            <Setter Property="Padding"
                                                                    Value="0"/>

                                                            <Setter Property="Margin"
                                                                    Value="0,0,0,10"/>

                                                        </Style>

                                                    </ListBox.ItemContainerStyle>


                                                    <ListBox.ItemTemplate>

                                                        <DataTemplate>

                                                            <Border BorderBrush="#374151"
                                                                    BorderThickness="0,0,0,1"
                                                                    Padding="0,0,0,8">

                                                                <StackPanel>

                                                                    <TextBlock Text="{Binding ReceivedAtText}"
                                                                               FontSize="10"
                                                                               Foreground="#9CA3AF"
                                                                               Margin="0,0,0,4"/>

                                                                    <TextBlock Text="{Binding Data}"
                                                                               FontSize="13"
                                                                               Foreground="#F9FAFB"
                                                                               TextWrapping="Wrap"/>

                                                                </StackPanel>

                                                            </Border>

                                                        </DataTemplate>

                                                    </ListBox.ItemTemplate>

                                                </ListBox>

                                            </Border>


                                            <!-- ================================================= -->
                                            <!-- ACTION AREA -->
                                            <!-- ================================================= -->

                                            <Grid Grid.Row="4">

                                                <Grid.RowDefinitions>

                                                    <!-- Connection Actions -->
                                                    <RowDefinition Height="Auto"/>

                                                    <!-- Order Query -->
                                                    <RowDefinition Height="Auto"/>

                                                    <!-- Send Message -->
                                                    <RowDefinition Height="Auto"/>

                                                </Grid.RowDefinitions>


                                                <!-- ================================================= -->
                                                <!-- CONNECTION ACTIONS -->
                                                <!-- ================================================= -->

                                                <Grid Grid.Row="0"
                                                      Margin="0,0,0,15">

                                                    <Grid.ColumnDefinitions>

                                                        <ColumnDefinition Width="*"/>

                                                        <ColumnDefinition Width="Auto"/>

                                                    </Grid.ColumnDefinitions>


                                                    <!-- LAST RECEIVED -->

                                                    <StackPanel Grid.Column="0"
                                                                VerticalAlignment="Center">

                                                        <TextBlock Text="Latest Message"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#6B7280"/>

                                                        <TextBlock Text="{Binding LastReceivedData, Mode=OneWay}"
                                                                   FontSize="12"
                                                                   Foreground="#374151"
                                                                   TextWrapping="Wrap"
                                                                   MaxWidth="500"
                                                                   Margin="0,3,0,0"/>

                                                    </StackPanel>


                                                    <!-- CONNECTION BUTTONS -->

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">

                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 Fill="{Binding StatusColor}"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center"/>

                                                        <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#374151"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,15,0"/>


                                                        <Button Content="Connect"
                                                                Width="75"
                                                                Height="30"
                                                                Margin="0,0,5,0"
                                                                Click="ConnectAnalyzerButton_Click"/>


                                                        <Button Content="Disconnect"
                                                                Width="85"
                                                                Height="30"
                                                                Margin="0,0,5,0"
                                                                Click="DisconnectAnalyzerButton_Click"/>


                                                        <Button Content="Reconnect"
                                                                Width="80"
                                                                Height="30"
                                                                Margin="0,0,5,0"
                                                                Click="ReconnectAnalyzerButton_Click"/>


                                                        <Button Content="Clear Data"
                                                                Width="88"
                                                                Height="30"
                                                                Style="{StaticResource SecondaryButton}"
                                                                Click="ClearReceivedDataButton_Click"/>

                                                    </StackPanel>

                                                </Grid>


                                                <!-- ================================================= -->
                                                <!-- ORDER QUERY AREA -->
                                                <!-- ================================================= -->

                                                <Border Grid.Row="1"
                                                        Background="#EFF6FF"
                                                        BorderBrush="#BFDBFE"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12"
                                                        Margin="0,0,0,15">

                                                    <Grid>

                                                        <Grid.RowDefinitions>

                                                            <RowDefinition Height="Auto"/>

                                                            <RowDefinition Height="Auto"/>

                                                        </Grid.RowDefinitions>


                                                        <!-- QUERY TITLE -->

                                                        <StackPanel Grid.Row="0"
                                                                    Margin="0,0,0,8">

                                                            <TextBlock Text="Order Query"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#111827"/>

                                                            <TextBlock Text="Enter a sample barcode to request the order from this analyzer."
                                                                       FontSize="10"
                                                                       Foreground="#6B7280"
                                                                       Margin="0,2,0,0"/>

                                                        </StackPanel>


                                                        <!-- QUERY INPUT -->

                                                        <Grid Grid.Row="1">

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>


                                                            <!-- BARCODE -->

                                                            <TextBox Grid.Column="0"
                                                                     MinHeight="38"
                                                                     Padding="10"
                                                                     Margin="0,0,10,0"
                                                                     VerticalContentAlignment="Center"
                                                                     Tag="Enter sample barcode"/>

                                                        </Grid>

                                                    </Grid>

                                                </Border>


                                                <!-- ================================================= -->
                                                <!-- BIDIRECTIONAL SEND AREA -->
                                                <!-- ================================================= -->

                                                <Border Grid.Row="2"
                                                        Background="#F9FAFB"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12">

                                                    <Grid>

                                                        <Grid.RowDefinitions>

                                                            <RowDefinition Height="Auto"/>

                                                            <RowDefinition Height="Auto"/>

                                                        </Grid.RowDefinitions>


                                                        <!-- SEND TITLE -->

                                                        <StackPanel Grid.Row="0"
                                                                    Margin="0,0,0,8">

                                                            <TextBlock Text="Send Test Message"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#111827"/>

                                                            <TextBlock Text="Test outbound communication from the application to the analyzer."
                                                                       FontSize="10"
                                                                       Foreground="#6B7280"
                                                                       Margin="0,2,0,0"/>

                                                        </StackPanel>


                                                        <!-- MESSAGE INPUT -->

                                                        <Grid Grid.Row="1">

                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>


                                                            <!-- MESSAGE -->

                                                            <TextBox x:Name="TestMessageTextBox"
                                                                     Grid.Column="0"
                                                                     MinHeight="55"
                                                                     MaxHeight="100"
                                                                     AcceptsReturn="True"
                                                                     TextWrapping="Wrap"
                                                                     VerticalScrollBarVisibility="Auto"
                                                                     Padding="10"
                                                                     Margin="0,0,10,0"
                                                                     Text="TEST MESSAGE"/>


                                                            <!-- SEND -->

                                                            <Button Grid.Column="1"
                                                                    Content="Send Test"
                                                                    Width="100"
                                                                    Height="35"
                                                                    VerticalAlignment="Top"
                                                                    Background="#16A34A"
                                                                    Foreground="White"
                                                                    BorderThickness="0"
                                                                    FontWeight="SemiBold"
                                                                    Cursor="Hand"
                                                                    Click="SendTestMessageButton_Click"/>

                                                        </Grid>

                                                    </Grid>

                                                </Border>

                                            </Grid>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>
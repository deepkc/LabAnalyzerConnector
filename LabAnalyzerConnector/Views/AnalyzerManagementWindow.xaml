<Window x:Class="LabAnalyzerConnector.Views.AnalyzerManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Analyzer Management"
        Width="1250"
        Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>

        <!-- ========================= -->
        <!-- Button Style -->
        <!-- ========================= -->

        <Style x:Key="ToolbarButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D1D5DB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EEF2FF"/>

                    <Setter Property="BorderBrush"
                            Value="#6366F1"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E0E7FF"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================= -->
        <!-- Primary Button -->
        <!-- ========================= -->

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButton}">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="Background"
                    Value="#4F46E5"/>

            <Setter Property="BorderBrush"
                    Value="#4F46E5"/>

        </Style>


        <!-- ========================= -->
        <!-- DataGrid -->
        <!-- ========================= -->

        <Style TargetType="DataGrid">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="RowHeight"
                    Value="42"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="GridLinesVisibility"
                    Value="Horizontal"/>

            <Setter Property="HorizontalGridLinesBrush"
                    Value="#EEF0F3"/>

            <Setter Property="VerticalGridLinesBrush"
                    Value="#EEF0F3"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

        </Style>


        <!-- ========================= -->
        <!-- DataGrid Header -->
        <!-- ========================= -->

        <Style TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#4B5563"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <!-- ========================= -->
        <!-- DataGrid Row -->
        <!-- ========================= -->

        <Style TargetType="DataGridRow">

            <Setter Property="Background"
                    Value="White"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8FAFC"/>

                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#EEF2FF"/>

                    <Setter Property="Foreground"
                            Value="#111827"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================= -->
        <!-- DataGrid Cell -->
        <!-- ========================= -->

        <Style TargetType="DataGridCell">

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </Window.Resources>


    <!-- ======================================= -->
    <!-- MAIN CONTAINER -->
    <!-- ======================================= -->

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ======================================= -->
        <!-- HEADER -->
        <!-- ======================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="Analyzer Management"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="#111827"/>

                <TextBlock
                    Text="Configure, monitor and manage laboratory analyzers"
                    FontSize="13"
                    Foreground="#6B7280"
                    Margin="0,5,0,0"/>

            </StackPanel>


            <Border
                Grid.Column="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8">

                <StackPanel
                    Orientation="Horizontal">

                    <Ellipse
                        Width="8"
                        Height="8"
                        Fill="#22C55E"
                        Margin="0,0,7,0"/>

                    <TextBlock
                        Text="Analyzer Interface"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#374151"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ======================================= -->
        <!-- TOOLBAR CARD -->
        <!-- ======================================= -->

        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12"
            Margin="0,0,0,18">

            <StackPanel
                Orientation="Horizontal">

                <Button
                    x:Name="AddButton"
                    Content="Add"
                    Width="85"
                    Click="AddButton_Click"
                    Style="{StaticResource PrimaryButton}"/>

                <Button
                    x:Name="EditButton"
                    Content="Edit"
                    Width="85"
                    Click="EditButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="DeleteButton"
                    Content="Delete"
                    Width="85"
                    Click="DeleteButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="DuplicateButton"
                    Content="Duplicate"
                    Width="100"
                    Click="DuplicateButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Border
                    Width="1"
                    Height="24"
                    Background="#E5E7EB"
                    Margin="4,0,12,0"/>

                <Button
                    x:Name="ConnectButton"
                    Content="Connect"
                    Width="90"
                    Click="ConnectButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="DisconnectButton"
                    Content="Disconnect"
                    Width="100"
                    Click="DisconnectButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="ReconnectButton"
                    Content="Reconnect"
                    Width="100"
                    Click="ReconnectButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Border
                    Width="1"
                    Height="24"
                    Background="#E5E7EB"
                    Margin="4,0,12,0"/>

                <Button
                    x:Name="ConnectAllButton"
                    Content="Connect All"
                    Width="105"
                    Click="ConnectAllButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="DisconnectAllButton"
                    Content="Disconnect All"
                    Width="120"
                    Click="DisconnectAllButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="RefreshButton"
                    Content="Refresh"
                    Width="90"
                    Click="RefreshButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

                <Button
                    x:Name="MappingButton"
                    Content="Mappings"
                    Width="100"
                    Click="MappingButton_Click"
                    Style="{StaticResource ToolbarButton}"/>

            </StackPanel>

        </Border>


        <!-- ======================================= -->
        <!-- ANALYZER TABLE -->
        <!-- ======================================= -->

        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            CornerRadius="10">

            <DataGrid
                ItemsSource="{Binding Analyzers}"
                SelectedItem="{Binding SelectedAnalyzer}"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                CanUserResizeRows="False"
                CanUserAddRows="False"
                SelectionMode="Single"
                SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn
                        Header="Name"
                        Binding="{Binding Name}"
                        Width="2*"/>

                    <DataGridTextColumn
                        Header="Manufacturer"
                        Binding="{Binding Manufacturer}"
                        Width="1.5*"/>

                    <DataGridTextColumn
                        Header="Model"
                        Binding="{Binding Model}"
                        Width="1.5*"/>

                    <DataGridTextColumn
                        Header="Protocol"
                        Binding="{Binding Protocol}"
                        Width="*"/>

                    <DataGridTextColumn
                        Header="Connection"
                        Binding="{Binding ConnectionType}"
                        Width="*"/>

                    <DataGridCheckBoxColumn
                        Header="Enabled"
                        Binding="{Binding Enabled}"
                        Width="80"/>

                    <DataGridTextColumn
                        Header="Status"
                        Binding="{Binding Status}"
                        Width="1.2*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </Grid>

</Window>
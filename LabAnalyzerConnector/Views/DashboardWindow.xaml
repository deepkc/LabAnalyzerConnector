<Window x:Class="LabAnalyzerConnector.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:controls="clr-namespace:LabAnalyzerConnector.Controls"
        Title="Dashboard"
        Width="1554"
        Height="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="PrimaryBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="DarkBlue" Color="#0B1B3A"/>
        <SolidColorBrush x:Key="DarkBlue2" Color="#102A56"/>
        <SolidColorBrush x:Key="PageBackground" Color="#F5F8FC"/>
        <SolidColorBrush x:Key="CardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>


        <!-- ========================================================= -->
        <!-- SIDEBAR BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="SidebarButton"
           TargetType="Button">

            <Setter Property="Background"
                Value="Transparent"/>

            <Setter Property="Foreground"
                Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="FontSize"
                Value="13"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="HorizontalContentAlignment"
                Value="Left"/>

            <Setter Property="Padding"
                Value="18,13"/>

            <Setter Property="Margin"
                Value="0,3"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="9">

                            <ContentPresenter
                            Margin="4,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#183B73"/>

                    <Setter Property="Foreground"
                        Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- ACTIVE SIDEBAR BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="ActiveSidebarButton"
           TargetType="Button"
           BasedOn="{StaticResource SidebarButton}">

            <Setter Property="Background"
                Value="#2154A3"/>

            <Setter Property="Foreground"
                Value="White"/>

        </Style>


        <!-- ========================================================= -->
        <!-- TOP NAVIGATION BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="DashboardNavButton"
           TargetType="Button">

            <Setter Property="Background"
                Value="White"/>

            <Setter Property="Foreground"
                Value="#334155"/>

            <Setter Property="BorderBrush"
                Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                Value="1"/>

            <Setter Property="FontSize"
                Value="12"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Padding"
                Value="15,0"/>

            <Setter Property="Margin"
                Value="0,0,10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#EFF6FF"/>

                    <Setter Property="BorderBrush"
                        Value="#93C5FD"/>

                    <Setter Property="Foreground"
                        Value="#1D4ED8"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ========================================================= -->
        <!-- PRIMARY ACTION -->
        <!-- ========================================================= -->

        <Style x:Key="PrimaryActionButton"
           TargetType="Button">

            <Setter Property="Background"
                Value="#2563EB"/>

            <Setter Property="Foreground"
                Value="White"/>

            <Setter Property="BorderThickness"
                Value="0"/>

            <Setter Property="FontSize"
                Value="12"/>

            <Setter Property="FontWeight"
                Value="SemiBold"/>

            <Setter Property="Cursor"
                Value="Hand"/>

            <Setter Property="Padding"
                Value="16,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="9"
                        Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                     Value="True">

                    <Setter Property="Background"
                        Value="#1D4ED8"/>

                </Trigger>

                <Trigger Property="IsPressed"
                     Value="True">

                    <Setter Property="Background"
                        Value="#1E40AF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ============================================================= -->
    <!-- ROOT -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource PageBackground}">

        <Grid.ColumnDefinitions>

            <!-- SIDEBAR -->

            <ColumnDefinition Width="235"/>

            <!-- MAIN -->

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ========================================================= -->
        <!-- SIDEBAR -->
        <!-- ========================================================= -->

        <Border Grid.Column="0"
            Background="{StaticResource DarkBlue}">

            <Grid Margin="12">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <!-- BRAND -->

                <StackPanel Grid.Row="0"
                        Margin="10,15,10,28">

                    <StackPanel Orientation="Horizontal">

                        <Border
                        Width="42"
                        Height="42"
                        Background="#183B73"
                        CornerRadius="11">

                            <TextBlock
                            Text="⚗"
                            FontSize="25"
                            Foreground="#60A5FA"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="12,0,0,0"
                                VerticalAlignment="Center">

                            <TextBlock
                            Text=""
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White"/>

                            <TextBlock
                            Text="Laboratory Interface Engine"
                            FontSize="10"
                            Foreground="#94A3B8"
                            Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>


                <!-- SIDEBAR NAVIGATION -->

                <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>


                        <!-- DASHBOARD -->

                        <Button
                        Content="⌂    Dashboard"
                        Style="{StaticResource ActiveSidebarButton}"/>


                        <!-- ORDERS -->

                        <Button
                        Content="▤    Orders"
                        Style="{StaticResource SidebarButton}"
                        Click="OrdersButton_Click"/>


                        <!-- CREATE ORDER -->

                        <Button
                        Content="＋    Create Order"
                        Style="{StaticResource SidebarButton}"
                        Click="CreateOrderButton_Click"/>


                        <!-- ANALYZERS -->

                        <Button
                        Content="▣    Analyzers"
                        Style="{StaticResource SidebarButton}"
                        Click="AddAnalyzerButton_Click"/>


                        <!-- MANAGEMENT -->

                        <Button
                        Content="⚙    Analyzer Management"
                        Style="{StaticResource SidebarButton}"
                        Click="AnalyzerManagementButton_Click"/>


                        <!-- RESULTS -->

                        <Button
                        Content="▤    Results"
                        Style="{StaticResource SidebarButton}"/>


                        <!-- MESSAGES -->

                        <Button
                        Content="▱    Messages"
                        Style="{StaticResource SidebarButton}"/>


                        <!-- LOGS -->

                        <Button
                        Content="▥    Logs"
                        Style="{StaticResource SidebarButton}"/>


                        <!-- TEST CONSOLE -->

                        <Button
                        Content="▣    Test Console"
                        Style="{StaticResource SidebarButton}"
                        Click="TestConsoleButton_Click"/>


                        <Separator
                        Margin="8,18"
                        Background="#28446F"
                        Foreground="#28446F"/>


                        <!-- SETTINGS -->

                        <Button
                        Content="⚙    Settings"
                        Style="{StaticResource SidebarButton}"/>

                    </StackPanel>

                </ScrollViewer>


                <!-- ENGINE STATUS -->

                <Border Grid.Row="2"
                    Margin="2,15,2,4"
                    Padding="14"
                    Background="#102A56"
                    BorderBrush="#284A7B"
                    BorderThickness="1"
                    CornerRadius="12">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="Auto"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Border
                        Width="38"
                        Height="38"
                        CornerRadius="19"
                        Background="#183B73">

                            <TextBlock
                            Text="▤"
                            FontSize="19"
                            Foreground="#CBD5E1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Grid.Column="1"
                                Margin="10,0,0,0">

                            <TextBlock
                            Text="Interface Engine"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,4,0,0">

                                <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#22C55E"
                                VerticalAlignment="Center"/>

                                <TextBlock
                                Text=" Running"
                                FontSize="11"
                                Foreground="#86EFAC"/>

                            </StackPanel>

                            <TextBlock
                            Text="v1.0.0.0"
                            FontSize="10"
                            Foreground="#94A3B8"
                            Margin="0,5,0,0"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- MAIN -->
        <!-- ========================================================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <!-- HEADER -->

                <RowDefinition Height="82"/>

                <!-- TOP NAV -->

                <RowDefinition Height="108"/>

                <!-- SUMMARY -->

                <RowDefinition Height="120"/>

                <!-- CONTENT -->

                <RowDefinition Height="43*"/>
                <RowDefinition Height="88*"/>

            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- HEADER -->
            <!-- ===================================================== -->

            <Border Grid.Row="0"
                Background="#0B1B3A">

                <Grid Margin="26,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel VerticalAlignment="Center">

                        <TextBlock
                        Text="Lab Analyzer Connector"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="White"/>

                        <TextBlock
                        Text="Laboratory Interface Engine"
                        FontSize="11"
                        Foreground="#94A3B8"
                        Margin="0,3,0,0"/>

                    </StackPanel>


                    <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">


                        <!-- ONLINE -->

                        <Border
                        Background="#064E3B"
                        BorderBrush="#065F46"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="14,8"
                        Margin="0,0,24,0">

                            <StackPanel
                            Orientation="Horizontal">

                                <Ellipse
                                Width="8"
                                Height="8"
                                Fill="#22C55E"
                                Margin="0,0,8,0"/>

                                <TextBlock
                                Text="System Online"
                                Foreground="#D1FAE5"
                                FontWeight="SemiBold"
                                FontSize="11"/>

                            </StackPanel>

                        </Border>


                        <!-- ADMIN -->

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                            Text="Administrator"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="12"/>

                            <TextBlock
                            Text="Interface Engine"
                            Foreground="#94A3B8"
                            FontSize="10"
                            Margin="0,3,0,0"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- TOP NAVIGATION CARDS -->
            <!-- ===================================================== -->

            <Border Grid.Row="1"
                Background="{StaticResource PageBackground}">

                <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled">

                    <StackPanel
                    Orientation="Horizontal"
                    Margin="24,14">


                        <!-- DASHBOARD -->

                        <Border
                        Width="112"
                        Height="82"
                        Margin="0,0,12,0"
                        Background="White"
                        BorderBrush="#93C5FD"
                        BorderThickness="1"
                        CornerRadius="12">

                            <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                                <Border
                                Width="38"
                                Height="38"
                                CornerRadius="19"
                                Background="#EFF6FF">

                                    <TextBlock
                                    Text="⌂"
                                    FontSize="21"
                                    Foreground="#2563EB"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                Text="Dashboard"
                                Margin="0,5,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#2563EB"
                                HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Border>


                        <!-- ORDERS -->

                        <Button
                        Content="▤&#x0a;Orders"
                        Style="{StaticResource DashboardNavButton}"
                        Width="112"
                        Height="82"
                        Click="OrdersButton_Click"/>


                        <!-- CREATE ORDER -->

                        <Button
                        Content="＋&#x0a;Create Order"
                        Style="{StaticResource DashboardNavButton}"
                        Width="125"
                        Height="82"
                        Click="CreateOrderButton_Click"/>


                        <!-- ADD ANALYZER -->

                        <Button
                        Content="⚗&#x0a;Add Analyzer"
                        Style="{StaticResource DashboardNavButton}"
                        Width="125"
                        Height="82"
                        Click="AddAnalyzerButton_Click"/>


                        <!-- MANAGEMENT -->

                        <Button
                        Content="⚙&#x0a;Analyzer Management"
                        Style="{StaticResource DashboardNavButton}"
                        Width="155"
                        Height="82"
                        Click="AnalyzerManagementButton_Click"/>


                        <!-- RESULTS -->

                        <Button
                        Content="▤&#x0a;Results"
                        Style="{StaticResource DashboardNavButton}"
                        Width="115"
                        Height="82"/>


                        <!-- MESSAGES -->

                        <Button
                        Content="▱&#x0a;Messages"
                        Style="{StaticResource DashboardNavButton}"
                        Width="115"
                        Height="82"/>


                        <!-- LOGS -->

                        <Button
                        Content="▥&#x0a;Logs"
                        Style="{StaticResource DashboardNavButton}"
                        Width="105"
                        Height="82"/>


                        <!-- TEST CONSOLE -->

                        <Button
                        Content="▣&#x0a;Test Console"
                        Style="{StaticResource DashboardNavButton}"
                        Width="125"
                        Height="82"
                        Click="TestConsoleButton_Click"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>


            <!-- ===================================================== -->
            <!-- SUMMARY -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2"
              Margin="24,4,24,12">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- MESSAGES -->

                <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                            Text="Messages Received"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#64748B"/>

                            <TextBlock
                            Text="{Binding Dashboard.MessagesReceived}"
                            Margin="0,4,0,0"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="#2563EB"/>

                            <TextBlock
                            Text="Total Received"
                            Margin="0,3,0,0"
                            FontSize="10"
                            Foreground="#94A3B8"/>

                        </StackPanel>

                        <Border
                        Grid.Column="1"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="#EFF6FF">

                            <TextBlock
                            Text="✉"
                            FontSize="21"
                            Foreground="#2563EB"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- RESULTS -->

                <Border
                Grid.Column="1"
                Margin="8,0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                            Text="Results Saved"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#64748B"/>

                            <TextBlock
                            Text="{Binding Dashboard.ResultsSaved}"
                            Margin="0,4,0,0"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="#16A34A"/>

                            <TextBlock
                            Text="Total Saved"
                            Margin="0,3,0,0"
                            FontSize="10"
                            Foreground="#94A3B8"/>

                        </StackPanel>

                        <Border
                        Grid.Column="1"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="#ECFDF5">

                            <TextBlock
                            Text="✓"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#16A34A"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ANALYZERS -->

                <Border
                Grid.Column="2"
                Margin="8,0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                            Text="Active Analyzers"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#64748B"/>

                            <TextBlock
                            Text="{Binding Analyzers.Count}"
                            Margin="0,4,0,0"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="#7C3AED"/>

                            <TextBlock
                            Text="Configured"
                            Margin="0,3,0,0"
                            FontSize="10"
                            Foreground="#94A3B8"/>

                        </StackPanel>

                        <Border
                        Grid.Column="1"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="#F5F3FF">

                            <TextBlock
                            Text="⚙"
                            FontSize="20"
                            Foreground="#7C3AED"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- ERRORS -->

                <Border
                Grid.Column="3"
                Margin="8,0,0,0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock
                            Text="Errors"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#64748B"/>

                            <TextBlock
                            Text="{Binding Dashboard.Errors}"
                            Margin="0,4,0,0"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="#DC2626"/>

                            <TextBlock
                            Text="System Errors"
                            Margin="0,3,0,0"
                            FontSize="10"
                            Foreground="#94A3B8"/>

                        </StackPanel>

                        <Border
                        Grid.Column="1"
                        Width="42"
                        Height="42"
                        CornerRadius="21"
                        Background="#FEF2F2">

                            <TextBlock
                            Text="!"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#DC2626"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- MAIN CONTENT -->
            <!-- ===================================================== -->

            <Grid Grid.Row="3"
              Margin="18,0,18,18" Grid.RowSpan="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="3.2*"/>

                    <ColumnDefinition Width="1.35*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- ANALYZERS -->
                <!-- ================================================= -->

                <Border
                Grid.Column="0"
                Margin="0,0,8,0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="18">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <!-- HEADER -->

                        <Grid Grid.Row="0"
                          Margin="2,0,2,14">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel>

                                <TextBlock
                                Text="Analyzers"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#111827"/>

                                <TextBlock
                                Text="Connected laboratory instruments"
                                FontSize="11"
                                Foreground="#64748B"
                                Margin="0,3,0,0"/>

                            </StackPanel>


                            <Button
                            Grid.Column="1"
                            Content="+  Add Analyzer"
                            Style="{StaticResource PrimaryActionButton}"
                            Width="140"
                            Height="38"
                            Click="AddAnalyzerButton_Click"/>

                        </Grid>


                        <!-- ANALYZER LIST -->

                        <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl
                            ItemsSource="{Binding Analyzers}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <!-- IMPORTANT:
                                         No extra Border here.
                                         AnalyzerCard already contains its own card. -->

                                        <controls:AnalyzerCard
                                        Analyzer="{Binding}"
                                        Loaded="AnalyzerCard_Loaded"/>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- RECENT ACTIVITY -->
                <!-- ================================================= -->

                <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Background="White"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>


                        <StackPanel Grid.Row="0">

                            <TextBlock
                            Text="Recent Activity"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#111827"/>

                            <TextBlock
                            Text="Latest interface events"
                            FontSize="11"
                            Foreground="#64748B"
                            Margin="0,3,0,0"/>

                        </StackPanel>


                        <ListBox
                        Grid.Row="1"
                        Margin="0,18,0,0"
                        BorderThickness="0"
                        Background="Transparent"
                        ItemsSource="{Binding Dashboard.Activity}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">


                            <ListBox.ItemContainerStyle>

                                <Style TargetType="ListBoxItem">

                                    <Setter
                                    Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                                    <Setter
                                    Property="Padding"
                                    Value="0"/>

                                    <Setter
                                    Property="Margin"
                                    Value="0,0,0,8"/>

                                    <Setter
                                    Property="BorderThickness"
                                    Value="0"/>

                                </Style>

                            </ListBox.ItemContainerStyle>


                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Border
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition
                                                Width="Auto"/>

                                                <ColumnDefinition
                                                Width="*"/>

                                            </Grid.ColumnDefinitions>


                                            <Border
                                            Width="34"
                                            Height="34"
                                            CornerRadius="17"
                                            Background="#EFF6FF">

                                                <TextBlock
                                                Text="•"
                                                FontSize="22"
                                                Foreground="#2563EB"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                            </Border>


                                            <StackPanel
                                            Grid.Column="1"
                                            Margin="10,0,0,0">

                                                <TextBlock
                                                Text="{Binding Type}"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="#111827"/>

                                                <TextBlock
                                                Text="{Binding Message}"
                                                Margin="0,3,0,0"
                                                FontSize="11"
                                                Foreground="#475569"
                                                TextWrapping="Wrap"/>

                                                <TextBlock
                                                Text="{Binding Time}"
                                                Margin="0,5,0,0"
                                                FontSize="10"
                                                Foreground="#94A3B8"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
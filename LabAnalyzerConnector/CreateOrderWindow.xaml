<Window x:Class="LabAnalyzerConnector.CreateOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Laboratory Order"
        Width="700"
        Height="700"
        MinWidth="650"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Background="#F3F4F6"
          Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Create Laboratory Order"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Text="Create an order that can be requested by a connected analyzer."
                       FontSize="13"
                       Foreground="#6B7280"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- FORM -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Analyzer -->
                    <RowDefinition Height="Auto"/>

                    <!-- Patient ID -->
                    <RowDefinition Height="Auto"/>

                    <!-- Patient Name -->
                    <RowDefinition Height="Auto"/>

                    <!-- Specimen ID -->
                    <RowDefinition Height="Auto"/>

                    <!-- Barcode -->
                    <RowDefinition Height="Auto"/>

                    <!-- Priority -->
                    <RowDefinition Height="Auto"/>

                    <!-- Test Code -->
                    <RowDefinition Height="Auto"/>

                    <!-- Add Test -->
                    <RowDefinition Height="Auto"/>

                    <!-- Selected Tests -->
                    <RowDefinition Height="Auto"/>

                    <!-- Remove Test -->
                    <RowDefinition Height="Auto"/>

                    <!-- Status -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="150"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- ANALYZER -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Analyzer:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="AnalyzerComboBox"
                          Grid.Row="0"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,0,0,15"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="Name"/>


                <!-- ================================================= -->
                <!-- PATIENT ID -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Patient ID:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="PatientIdTextBox"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         VerticalContentAlignment="Center"/>


                <!-- ================================================= -->
                <!-- PATIENT NAME -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Patient Name:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="PatientNameTextBox"
                         Grid.Row="2"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         VerticalContentAlignment="Center"/>


                <!-- ================================================= -->
                <!-- SPECIMEN ID -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Specimen ID:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="SpecimenIdTextBox"
                         Grid.Row="3"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         VerticalContentAlignment="Center"/>


                <!-- ================================================= -->
                <!-- BARCODE -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Barcode:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="BarcodeTextBox"
                         Grid.Row="4"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         VerticalContentAlignment="Center"/>


                <!-- ================================================= -->
                <!-- PRIORITY -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Priority:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="PriorityComboBox"
                          Grid.Row="5"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,0,0,15"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Routine"
                                  IsSelected="True"/>

                    <ComboBoxItem Content="Urgent"/>

                    <ComboBoxItem Content="STAT"/>

                </ComboBox>


                <!-- ================================================= -->
                <!-- TEST CODE -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Test Codes:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <TextBox x:Name="TestCodeTextBox"
                         Grid.Row="6"
                         Grid.Column="1"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         ToolTip="Enter a test code, for example CBC"/>


                <!-- ================================================= -->
                <!-- ADD TEST -->
                <!-- ================================================= -->

                <Button Grid.Row="7"
                        Grid.Column="1"
                        Content="Add Test"
                        Width="100"
                        Height="32"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,15"
                        Click="AddTestButton_Click"/>


                <!-- ================================================= -->
                <!-- SELECTED TESTS -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="8"
                           Grid.Column="0"
                           Text="Selected Tests:"
                           VerticalAlignment="Top"
                           Margin="0,8,15,15"
                           FontWeight="SemiBold"/>

                <ListBox x:Name="SelectedTestsListBox"
                         Grid.Row="8"
                         Grid.Column="1"
                         Height="120"
                         Margin="0,0,0,15"
                         SelectionMode="Single"/>


                <!-- ================================================= -->
                <!-- REMOVE SELECTED TEST -->
                <!-- ================================================= -->

                <Button Grid.Row="9"
                        Grid.Column="1"
                        Content="Remove Selected Test"
                        Width="160"
                        Height="32"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,15"
                        Click="RemoveSelectedTestButton_Click"/>


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="10"
                           Grid.Column="0"
                           Text="Status:"
                           VerticalAlignment="Center"
                           Margin="0,0,15,15"
                           FontWeight="SemiBold"/>

                <ComboBox x:Name="StatusComboBox"
                          Grid.Row="10"
                          Grid.Column="1"
                          Height="35"
                          Margin="0,0,0,15"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Pending"
                                  IsSelected="True"/>

                    <ComboBoxItem Content="In Progress"/>

                    <ComboBoxItem Content="Completed"/>

                    <ComboBoxItem Content="Cancelled"/>

                </ComboBox>

            </Grid>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Cancel"
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button Content="Save Order"
                    Width="120"
                    Height="35"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Click="CreateOrderButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
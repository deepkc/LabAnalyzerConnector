<Window x:Class="LabAnalyzerConnector.Views.TestConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protocol Test Console"
        Width="1200"
        Height="750"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="220"/>

        </Grid.RowDefinitions>

        <!-- Top Controls -->

        <StackPanel Orientation="Horizontal">

            <TextBlock Text="Protocol"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="ProtocolComboBox"
                      Width="150"
                      Margin="0,0,20,0"/>

            <TextBlock Text="Analyzer"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="AnalyzerComboBox"
                      Width="250"
                      Margin="0,0,20,0"/>

            <TextBlock Text="Direction"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <ComboBox x:Name="DirectionComboBox"
                      Width="150"/>

        </StackPanel>

        <!-- Message Editor -->

        <TextBox
            Grid.Row="1"
            x:Name="MessageTextBox"
            Margin="0,20,0,20"
            AcceptsReturn="True"
            AcceptsTab="True"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            FontFamily="Consolas"
            FontSize="14"
            TextWrapping="NoWrap"/>

        <!-- Buttons -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button x:Name="SendButton"
                    Content="Send"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="SendButton_Click"/>

            <Button x:Name="ClearButton"
                    Content="Clear"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="ClearButton_Click"/>

            <Button x:Name="LoadSampleButton"
                    Content="Load Sample"
                    Width="120"
                    Margin="0,0,10,0"
                    Click="LoadSampleButton_Click"/>

        </StackPanel>

        <!-- Log -->

        <GroupBox Grid.Row="3"
                  Header="Console Log"
                  Margin="0,20,0,0">

            <TextBox
                x:Name="LogTextBox"
                IsReadOnly="True"
                FontFamily="Consolas"
                AcceptsReturn="True"
                VerticalScrollBarVisibility="Auto"/>

        </GroupBox>

    </Grid>

</Window>